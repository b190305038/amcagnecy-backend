# Copy to .env and adjust. NEVER commit the real .env.

# --- Core -------------------------------------------------------------------
# Generate a fresh key for production:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=False
ALLOWED_HOSTS=sales.ibitltd.com,127.0.0.1,localhost

# --- Database ---------------------------------------------------------------
# DB_ENGINE=sqlite  -> local file db (default, dev only)
# DB_ENGINE=mysql   -> production MySQL (fill in the DB_* values below)
DB_ENGINE=mysql
DB_NAME=sales_monitoring
DB_USER=sales_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- CORS / CSRF ------------------------------------------------------------
# Origins allowed to call the API from the browser (your frontend URLs).
CORS_ALLOWED_ORIGINS=https://sales.ibitltd.com,http://localhost:5173,http://localhost:5174
# Origins trusted for admin/session POSTs (must include scheme). HTTPS in prod.
CSRF_TRUSTED_ORIGINS=https://sales.ibitltd.com

# --- HTTPS (only applied when DEBUG=False) ----------------------------------
# Set to False if TLS is not yet terminated in front of Django.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- JWT token lifetimes ----------------------------------------------------
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
